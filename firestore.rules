rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validDicomUid(value) {
      return value is string && value.size() <= 64
        && value.matches('^(0|[1-9][0-9]*)([.](0|[1-9][0-9]*))+$');
    }
    match /users/{uid}/dicom_uid_claims/{claimKey} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && claimKey.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasAll(['owner_uid', 'dicom_uid', 'role'])
        && request.resource.data.keys().hasOnly(['owner_uid', 'dicom_uid', 'role'])
        && request.resource.data.owner_uid == uid
        && validDicomUid(request.resource.data.dicom_uid)
        && request.resource.data.role in ['study', 'series', 'instance'];
      // A UID cannot be reassigned to another object role.
    }
    match /users/{uid}/dicom_instances/{instanceKey} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function matchesParents(d) {
        let study = get(/databases/$(database)/documents/users/$(uid)/studies/$(d.study_key)).data;
        let series = get(/databases/$(database)/documents/users/$(uid)/series/$(d.series_key)).data;
        return study.owner_uid == uid && study.study_id == d.study_id
          && study.patient_id == d.patient_id && study.issuer == d.issuer
          && series.owner_uid == uid && series.study_id == d.study_id
          && series.series_id == d.series_id && series.study_key == d.study_key
          && series.modality == d.modality && series.body_region == d.body_region;
      }
      function matchingClaims(d) {
        let study = get(/databases/$(database)/documents/users/$(uid)/dicom_uid_claims/$(d.study_key)).data;
        let series = get(/databases/$(database)/documents/users/$(uid)/dicom_uid_claims/$(d.series_key)).data;
        let instance = get(/databases/$(database)/documents/users/$(uid)/dicom_uid_claims/$(instanceKey)).data;
        return study.owner_uid == uid && study.dicom_uid == d.study_id && study.role == 'study'
          && series.owner_uid == uid && series.dicom_uid == d.series_id && series.role == 'series'
          && instance.owner_uid == uid && instance.dicom_uid == d.sop_uid && instance.role == 'instance';
      }
      allow get, list: if isOwner();
      allow create: if isOwner() && instanceKey.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasAll(['owner_uid', 'issuer', 'patient_id', 'study_id', 'study_key', 'series_id', 'series_key', 'sop_uid', 'sop_class_uid', 'frame_count', 'modality', 'body_region', 'original_key', 'content_hash'])
        && request.resource.data.keys().hasOnly(['owner_uid', 'issuer', 'patient_id', 'study_id', 'study_key', 'series_id', 'series_key', 'sop_uid', 'sop_class_uid', 'frame_count', 'modality', 'body_region', 'original_key', 'content_hash'])
        && request.resource.data.owner_uid == uid
        && validDicomUid(request.resource.data.study_id)
        && validDicomUid(request.resource.data.series_id)
        && validDicomUid(request.resource.data.sop_uid)
        && validDicomUid(request.resource.data.sop_class_uid)
        && request.resource.data.study_id != request.resource.data.series_id
        && request.resource.data.study_id != request.resource.data.sop_uid
        && request.resource.data.series_id != request.resource.data.sop_uid
        && request.resource.data.sop_class_uid != request.resource.data.study_id
        && request.resource.data.sop_class_uid != request.resource.data.series_id
        && request.resource.data.sop_class_uid != request.resource.data.sop_uid
        && request.resource.data.study_key is string && request.resource.data.study_key.matches('^[0-9a-f]{64}$')
        && request.resource.data.series_key is string && request.resource.data.series_key.matches('^[0-9a-f]{64}$')
        && request.resource.data.content_hash is string && request.resource.data.content_hash.matches('^[0-9a-f]{64}$')
        && request.resource.data.original_key == request.resource.data.content_hash + '.dcm'
        && request.resource.data.frame_count is int && request.resource.data.frame_count >= 0
        && request.resource.data.frame_count <= 2147483647
        && matchesParents(request.resource.data) && matchingClaims(request.resource.data);
      // No update or delete: same SOP UID and different bytes must be held for review.
    }
    match /users/{uid}/patients/{patientKey} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      allow get, list: if isOwner();
      allow create: if isOwner() && patientKey.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasAll(['owner_uid', 'issuer', 'patient_id'])
        && request.resource.data.keys().hasOnly(['owner_uid', 'issuer', 'patient_id'])
        && request.resource.data.owner_uid == uid
        && request.resource.data.issuer is string
        && request.resource.data.issuer.size() > 0 && request.resource.data.issuer.size() <= 128
        && request.resource.data.patient_id is string
        && request.resource.data.patient_id.size() > 0 && request.resource.data.patient_id.size() <= 128;
      // Identities are immutable: no update or delete permission.
    }
    match /users/{uid}/studies/{studyKey} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function matchesPatient(d) {
        let patient = get(/databases/$(database)/documents/users/$(uid)/patients/$(d.patient_key)).data;
        return patient.owner_uid == uid && patient.issuer == d.issuer
          && patient.patient_id == d.patient_id;
      }
      allow get, list: if isOwner();
      allow create: if isOwner() && studyKey.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasAll(['owner_uid', 'study_id', 'patient_key', 'issuer', 'patient_id'])
        && request.resource.data.keys().hasOnly(['owner_uid', 'study_id', 'patient_key', 'issuer', 'patient_id'])
        && request.resource.data.owner_uid == uid
        && request.resource.data.study_id is string
        && request.resource.data.study_id.size() > 0 && request.resource.data.study_id.size() <= 128
        && request.resource.data.patient_key is string
        && request.resource.data.patient_key.matches('^[0-9a-f]{64}$')
        && request.resource.data.issuer is string && request.resource.data.patient_id is string
        && matchesPatient(request.resource.data);
      // Study-patient associations are immutable: no update or delete permission.
    }
    match /users/{uid}/study_details/{studyKey} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validDetails(d) {
        let study = get(/databases/$(database)/documents/users/$(uid)/studies/$(studyKey)).data;
        return studyKey.matches('^[0-9a-f]{64}$')
          && d.keys().hasAll(['owner_uid', 'study_id', 'study_key', 'acquired_on', 'linkage_status', 'receipt_status'])
          && d.keys().hasOnly(['owner_uid', 'study_id', 'study_key', 'acquired_on', 'linkage_status', 'receipt_status'])
          && d.owner_uid == uid && d.study_key == studyKey
          && d.study_id is string && d.study_id.size() > 0 && d.study_id.size() <= 128
          && study.owner_uid == uid && study.study_id == d.study_id
          && d.acquired_on is string
          && (d.acquired_on == '' || d.acquired_on.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && d.linkage_status in ['unconfirmed', 'confirmed', 'conflict', 'on_hold']
          && d.receipt_status in ['unknown', 'receiving', 'partial', 'failed'];
      }
      allow get, list: if isOwner();
      allow create: if isOwner() && validDetails(request.resource.data);
      allow update: if isOwner() && validDetails(request.resource.data)
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.study_id == resource.data.study_id
        && request.resource.data.study_key == resource.data.study_key;
      // No delete permission; clients use an update-time precondition for edits.
    }
    match /users/{uid}/series/{seriesKey} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function matchesStudy(d) {
        let study = get(/databases/$(database)/documents/users/$(uid)/studies/$(d.study_key)).data;
        return study.owner_uid == uid && study.study_id == d.study_id;
      }
      allow get, list: if isOwner();
      allow create: if isOwner() && seriesKey.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasAll(['owner_uid', 'study_id', 'study_key', 'series_id', 'modality', 'body_region'])
        && request.resource.data.keys().hasOnly(['owner_uid', 'study_id', 'study_key', 'series_id', 'modality', 'body_region'])
        && request.resource.data.owner_uid == uid
        && request.resource.data.study_id is string && request.resource.data.study_id.size() > 0
        && request.resource.data.study_id.size() <= 128
        && request.resource.data.series_id is string && request.resource.data.series_id.size() > 0
        && request.resource.data.series_id.size() <= 128
        && request.resource.data.study_key is string
        && request.resource.data.study_key.matches('^[0-9a-f]{64}$')
        && request.resource.data.modality is string && request.resource.data.modality.size() <= 128
        && request.resource.data.body_region is string && request.resource.data.body_region.size() <= 128
        && matchesStudy(request.resource.data);
      // Series associations are immutable: no update or delete permission.
    }
    match /users/{uid}/study_images/{imageKey} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function matchesStudy(d) {
        let study = get(/databases/$(database)/documents/users/$(uid)/studies/$(d.study_key)).data;
        return study.owner_uid == uid && study.study_id == d.study_id;
      }
      function matchesSeries(d) {
        let series = get(/databases/$(database)/documents/users/$(uid)/series/$(d.series_key)).data;
        return series.owner_uid == uid && series.series_id == d.series_id
          && series.study_id == d.study_id && series.study_key == d.study_key;
      }
      allow get, list: if isOwner();
      allow create: if isOwner() && imageKey.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasAll(['owner_uid', 'study_id', 'study_key', 'series_id', 'series_key', 'image_id', 'original_key'])
        && request.resource.data.keys().hasOnly(['owner_uid', 'study_id', 'study_key', 'series_id', 'series_key', 'image_id', 'original_key'])
        && request.resource.data.owner_uid == uid
        && request.resource.data.study_id is string && request.resource.data.study_id.size() > 0
        && request.resource.data.study_id.size() <= 128
        && request.resource.data.image_id is string && request.resource.data.image_id.size() > 0
        && request.resource.data.image_id.size() <= 128
        && request.resource.data.study_key is string
        && request.resource.data.study_key.matches('^[0-9a-f]{64}$')
        && request.resource.data.series_id is string && request.resource.data.series_id.size() > 0
        && request.resource.data.series_id.size() <= 128
        && request.resource.data.series_key is string
        && request.resource.data.series_key.matches('^[0-9a-f]{64}$')
        && request.resource.data.original_key is string
        && request.resource.data.original_key.matches('^[0-9a-f]{64}\\.(png|jpg)$')
        && matchesStudy(request.resource.data) && matchesSeries(request.resource.data);
      // Image associations are immutable: no update or delete permission.
    }
    match /starter_checks/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/cases/{caseId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validCase(d) {
        return caseId.matches('^[0-9a-f]{32}$')
          && d.keys().hasAll(['owner_uid', 'title', 'note', 'provenance',
            'source_id', 'original_key', 'original_name', 'file_format',
            'width', 'height', 'byte_count', 'state', 'version',
            'operation_id', 'record_json', 'saved_at'])
          && d.keys().hasOnly(['owner_uid', 'title', 'note', 'provenance',
            'source_id', 'original_key', 'original_name', 'file_format',
            'width', 'height', 'byte_count', 'state', 'version',
            'operation_id', 'record_json', 'saved_at'])
          && d.owner_uid == uid && d.state == 'draft'
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.title.matches('.*[^\\s].*')
          && d.note is string && d.note.size() <= 4000
          && d.provenance is string && d.provenance.size() > 0 && d.provenance.size() <= 2000
          && d.original_name is string && d.original_name.size() > 0 && d.original_name.size() <= 512
          && d.source_id is string && d.source_id.matches('^[0-9a-f]{64}$')
          && d.file_format in ['PNG', 'JPEG']
          && d.original_key == d.source_id + (d.file_format == 'PNG' ? '.png' : '.jpg')
          && d.width is int && d.width > 0 && d.height is int && d.height > 0
          && d.width * d.height <= 20000000
          && d.byte_count is int && d.byte_count > 0 && d.byte_count <= 20971520
          && d.version is int && d.version > 0
          && d.operation_id is string && d.operation_id.matches('^[0-9a-f]{32}$')
          && d.record_json is string && d.record_json.size() <= 60000
          && d.saved_at == request.time;
      }
      function matchingVersion(d) {
        return getAfter(/databases/$(database)/documents/users/$(uid)/cases/$(caseId)/versions/$(d.operation_id)).data == d;
      }
      allow get, list: if isOwner();
      allow create: if isOwner() && validCase(request.resource.data)
        && request.resource.data.version == 1 && matchingVersion(request.resource.data);
      allow update: if isOwner() && validCase(request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'owner_uid', 'source_id', 'original_key', 'original_name',
          'file_format', 'width', 'height', 'byte_count'])
        && request.resource.data.operation_id != resource.data.operation_id
        && matchingVersion(request.resource.data);
      match /versions/{operationId} {
        allow get, list: if isOwner();
        allow create: if isOwner() && validCase(request.resource.data)
          && operationId == request.resource.data.operation_id
          && getAfter(/databases/$(database)/documents/users/$(uid)/cases/$(caseId)).data == request.resource.data;
        // No update or delete: previous versions remain immutable.
      }
    }
    match /users/{uid}/case_drafts/{draftId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      allow get, list: if isOwner();
      allow create: if isOwner()
        && draftId.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasAll([
          'owner_uid', 'title', 'note', 'stage', 'version', 'created_at'
        ])
        && request.resource.data.keys().hasOnly([
          'owner_uid', 'title', 'note', 'stage', 'version', 'created_at'
        ])
        && request.resource.data.owner_uid == uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.title.matches('.*[^\\s].*')
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 4000
        && request.resource.data.stage == 'metadata_only'
        && request.resource.data.version is int
        && request.resource.data.version == 1
        && request.resource.data.created_at == request.time;
      // Drafts are immutable in the first milestone; no update or delete permission.
    }
  }
}
